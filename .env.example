# PCG dashboard backend (server-side relays + admin SSO)
PCG_BACKEND_URL=https://dashboard.powerclubglobal.com

# Admin area session cookie encryption key.
# Required for /admin sign-in. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Backend-to-backend key for the founder-call bookings endpoint.
# Server-side only — never exposed to the browser.
FOUNDER_CALL_ADMIN_KEY=
